[Unit]
Description=Mail Sentinel FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hh
WorkingDirectory=/home/hh/mail-sentinel
EnvironmentFile=/home/hh/mail-sentinel/.env
ExecStart=/home/hh/mail-sentinel/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/hh/mail-sentinel/data

[Install]
WantedBy=multi-user.target
